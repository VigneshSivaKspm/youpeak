# Groq API key for the website chatbot (https://console.groq.com/keys).
# Copy this file to .env and paste your key. Note: VITE_ variables are
# bundled into the public JavaScript, so anyone can read this key.
VITE_GROQ_API_KEY=

# Optional: override the chat model (default: llama-3.3-70b-versatile).
# VITE_GROQ_MODEL=openai/gpt-oss-120b
